{
  "name": "eventscore-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "mock": "npx -y @stoplight/prism-cli@5 mock mock/openapi-mock.yaml -p 4010",
    "api:tipos": "npx -y openapi-typescript@7 ../docs/openapi/openapi-v0.1.yaml -o src/api/schema.d.ts",
    "test": "node --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  }
}
