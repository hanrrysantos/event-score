# Copie para .env (cp .env.example .env) e ajuste se necessário.
# Valores abaixo são apenas para desenvolvimento local. Nunca coloque credenciais reais aqui.

# Aplicação
NODE_ENV=development
PORT=3000
# Obrigatório para iniciar a API: gere um segredo local com openssl rand -hex 32.
# Não reutilize o mesmo segredo em ambientes diferentes e não o versione.
# JWT_SECRET=<valor-gerado-localmente>

# PostgreSQL (usado pelo compose.yaml)
POSTGRES_USER=eventscore
POSTGRES_PASSWORD=eventscore
POSTGRES_DB=eventscore
POSTGRES_PORT=5432

# Conexão da aplicação com o banco. Mantenha usuário, senha, porta e banco iguais aos de cima.
DATABASE_URL=postgresql://eventscore:eventscore@localhost:5432/eventscore

# Banco exclusivo para testes e2e. Crie-o separadamente antes de descomentar.
# TEST_DATABASE_URL=postgresql://eventscore:eventscore@localhost:5432/eventscore_test

# Administrador criado por `npm run db:seed` (dev) ou `npm run db:admin` (servidor).
# Defina ADMIN_SENHA localmente com ao menos 12 caracteres antes de rodar qualquer comando.
# Se sua instalação usou a antiga senha de exemplo, troque-a com db:admin e ADMIN_ATUALIZAR_EXISTENTE=true.
# Para atualizar uma conta existente com db:admin, defina ADMIN_ATUALIZAR_EXISTENTE=true apenas durante o comando.
ADMIN_NOME=Administrador
ADMIN_EMAIL=admin@eventscore.local
# ADMIN_SENHA=<senha-gerada-localmente>
