# Copie para .env (cp .env.example .env) e ajuste se necessário.
# Valores abaixo são apenas para desenvolvimento local. Nunca coloque credenciais reais aqui.

# Aplicação
NODE_ENV=development
PORT=3000

# PostgreSQL (usado pelo compose.yaml)
POSTGRES_USER=eventscore
POSTGRES_PASSWORD=eventscore
POSTGRES_DB=eventscore
POSTGRES_PORT=5432

# Conexão da aplicação com o banco. Mantenha usuário, senha, porta e banco iguais aos de cima.
DATABASE_URL=postgresql://eventscore:eventscore@localhost:5432/eventscore

# Administrador criado por `npm run db:seed` (dev) ou `npm run db:admin` (servidor).
# No servidor, defina valores reais nas variáveis do ambiente, nunca no repositório.
# A senha abaixo é pública: só o seed a aceita; o `npm run db:admin` a recusa.
ADMIN_NOME=Administrador
ADMIN_EMAIL=admin@eventscore.local
ADMIN_SENHA=troque-esta-senha
